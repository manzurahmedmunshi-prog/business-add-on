generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== AUTH & USERS ====================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String
  role          Role      @default(EVENT_MANAGER)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  checkIns      CheckIn[]
  auditLogs     AuditLog[]
}

enum Role {
  SUPER_ADMIN
  EVENT_MANAGER
  SPEAKER_MANAGER
  SPONSOR_MANAGER
  REGISTRATION_MANAGER
  CHECKIN_STAFF
  CUSTOM
}

// ==================== EVENT CONFIG ====================

model Event {
  id              String   @id @default(cuid())
  name            String   @default("BUSINESS ADD-ON")
  tagline         String   @default("Think Fast. Create Big. Build the Future.")
  description     String?  @db.Text
  category        String   @default("Business Festival")
  logoUrl         String?
  bannerUrl       String?
  startDate       DateTime?
  endDate         DateTime?
  startTime       String?
  endTime         String?
  timezone        String   @default("Asia/Kolkata")
  venueName       String?
  venueAddress    String?  @db.Text
  mapLink         String?
  organizerName   String?
  organizerEmail  String?
  organizerPhone  String?
  websiteUrl      String?
  socialLinks     Json?
  primaryColor    String   @default("#d4af37")
  secondaryColor  String   @default("#0a0f1a")
  isPublished     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  pages           EventPage[]
  ticketTypes     TicketType[]
  speakers        Speaker[]
  sponsors        Sponsor[]
  artists         Artist[]
  registrations   Registration[]
  challenges      Challenge[]
  spocs           Spoc[]
}

model EventPage {
  id          String   @id @default(cuid())
  eventId     String
  slug        String
  title       String
  content     String?  @db.Text
  isEnabled   Boolean  @default(true)
  sortOrder   Int      @default(0)
  metaTitle   String?
  metaDesc    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, slug])
}

// ==================== TICKETS & REGISTRATION ====================

model TicketType {
  id              String   @id @default(cuid())
  eventId         String
  name            String
  description     String?  @db.Text
  price           Decimal  @default(0) @db.Decimal(10, 2)
  currency        String   @default("INR")
  capacity        Int?
  isActive        Boolean  @default(true)
  isStudent       Boolean  @default(false)
  isVip           Boolean  @default(false)
  isChallenge     Boolean  @default(false)
  sortOrder       Int      @default(0)
  benefits        String[] 
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations   Registration[]
  spocAssignments SpocAssignment[]
}

model Registration {
  id              String   @id @default(cuid())
  eventId         String
  ticketTypeId    String
  registrationId  String   @unique // e.g. BA-2026-XXXX
  ticketNumber    String   @unique
  fullName        String
  email           String
  phone           String?
  organization    String?
  designation     String?
  city            String?
  country         String?  @default("India")
  customAnswers   Json?
  status          RegistrationStatus @default(PENDING)
  qrToken         String   @unique
  qrCodeUrl       String?
  checkedInAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  event           Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType      TicketType @relation(fields: [ticketTypeId], references: [id])
  checkIns        CheckIn[]

  @@index([email, eventId])
  @@index([status])
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  CHECKED_IN
}

model CheckIn {
  id              String   @id @default(cuid())
  registrationId  String
  checkedInById   String?
  checkedInAt     DateTime @default(now())
  notes           String?

  registration    Registration @relation(fields: [registrationId], references: [id])
  checkedInBy     User?        @relation(fields: [checkedInById], references: [id])
}

// ==================== PEOPLE ====================

model Speaker {
  id          String   @id @default(cuid())
  eventId     String
  name        String
  title       String?
  company     String?
  bio         String?  @db.Text
  photoUrl    String?
  linkedin    String?
  twitter     String?
  status      ContentStatus @default(PROPOSED)
  isFeatured  Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Sponsor {
  id          String   @id @default(cuid())
  eventId     String
  name        String
  logoUrl     String?
  website     String?
  tier        String?  // Title, Platinum, Gold, Silver, etc.
  description String?  @db.Text
  status      ContentStatus @default(PROPOSED)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Artist {
  id          String   @id @default(cuid())
  eventId     String
  name        String
  type        String?  // Singer, Band, Performer, Host
  bio         String?  @db.Text
  photoUrl    String?
  status      ContentStatus @default(PROPOSED)
  performanceDay String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

enum ContentStatus {
  PROPOSED
  INVITED
  IN_DISCUSSION
  CONFIRMED
  DECLINED
}

// ==================== CHALLENGES ====================

model Challenge {
  id              String   @id @default(cuid())
  eventId         String
  title           String
  slug            String
  description     String?  @db.Text
  brief           String?  @db.Text
  durationMinutes Int
  maxTeamSize     Int      @default(4)
  capacity        Int?
  startTime       DateTime?
  deadline        DateTime?
  status          ChallengeStatus @default(DRAFT)
  judgingCriteria Json?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, slug])
}

enum ChallengeStatus {
  DRAFT
  PUBLISHED
  OPEN
  CLOSED
  JUDGING
  COMPLETED
}

// ==================== SPOC ====================

model Spoc {
  id          String   @id @default(cuid())
  eventId     String
  name        String
  designation String?
  department  String?
  email       String
  phone       String?
  whatsapp    String?
  photoUrl    String?
  responsibility String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignments SpocAssignment[]
}

model SpocAssignment {
  id            String   @id @default(cuid())
  spocId        String
  ticketTypeId  String

  spoc          Spoc       @relation(fields: [spocId], references: [id], onDelete: Cascade)
  ticketType    TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)

  @@unique([spocId, ticketTypeId])
}

// ==================== AUDIT ====================

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  entityType  String?
  entityId    String?
  details     Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id])
}