# ===========================================
# BUSINESS ADD-ON - Environment Variables
# Copy this file to .env.local for local use
# On Vercel: Project → Settings → Environment Variables
# ===========================================

# Database (Neon PostgreSQL)
# Get from: https://console.neon.tech → your project → Connection string
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth
# Generate a random string: openssl rand -base64 32
NEXTAUTH_SECRET="generate-a-long-random-string-here"
NEXTAUTH_URL="http://localhost:3000"

# Cloudinary (Image storage)
# Get from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Resend (Email - optional for foundation)
# Get from: https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxx"
RESEND_FROM_EMAIL="onboarding@resend.dev"
RESEND_FROM_NAME="BUSINESS ADD-ON"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"