# ===========================================
# BUSINESS ADD-ON - Environment Variables
# Copy this file to .env.local for local use
# On Vercel: Project → Settings → Environment Variables
# ===========================================

# Database (Neon PostgreSQL)
# Get from: https://console.neon.tech → your project → Connection string
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth
# Generate a random string: https://generate-secret.vercel.app/32
NEXTAUTH_SECRET="generate-a-long-random-string-here"
NEXTAUTH_URL="http://localhost:3000"

# Vercel Blob (Image & file storage)
# Create a Blob store in Vercel Dashboard → Storage → Create Database → Blob
# Then copy the BLOB_READ_WRITE_TOKEN
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"

# Resend (Email - optional for foundation)
# Get from: https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxx"
RESEND_FROM_EMAIL="onboarding@resend.dev"
RESEND_FROM_NAME="BUSINESS ADD-ON"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
